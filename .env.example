# Choose "local" for an offline demo, "codex" for your local signed-in Codex demo,
# or "openai" for a public deployment.
AI_PROVIDER=local
HOST=127.0.0.1
PORT=4173
ENABLE_WEB_RESEARCH=true
RESEARCH_TIMEOUT_MS=90000

# Public deployment only — never commit real values.
# OPENAI_API_KEY=
# ALLOW_CODEX_ACCOUNT_SERVER=false
# APP_API_KEY=

# Optional private report archive and administrator viewer.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_REPORT_BUCKET=shadow-company-reports
# SUPABASE_REPORT_TABLE=generated_reports
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
